# Copie para .env e preencha. O .env está no .gitignore — ele não vai para o
# repositório, e token nenhum deve ser colado em conversa, mensagem ou commit.
#
#   cp .env.exemplo .env
#   nano .env
#   chmod 600 .env

# Repositório que este runner atende.
REPO=certimix/IParrot

# ---------------------------------------------------------------------------
# Autenticação — preencha UMA das duas.
# ---------------------------------------------------------------------------

# Opção A (recomendada): token de acesso pessoal fine-grained.
#
#   https://github.com/settings/personal-access-tokens/new
#   Repository access:  Only select repositories > certimix/IParrot
#   Permissions:        Administration > Read and write
#                       (só essa; nada de "Contents", nada de escopo de conta)
#   Expiration:         90 dias, e anote para renovar
#
# Com ele o container cria o próprio token de registro a cada partida, então
# aguenta reinício do servidor sem você mexer em nada.
GH_PAT=

# Opção B: token de registro, para um registro único e manual.
#
#   Settings > Actions > Runners > New self-hosted runner > Linux
#   copie só o valor depois de `--token`
#
# Vale uma hora. Depois do primeiro registro a credencial fica no volume e
# esta linha pode voltar a ficar vazia.
RUNNER_TOKEN=

# ---------------------------------------------------------------------------
# Identificação e recurso
# ---------------------------------------------------------------------------

# Nome na lista de runners do repositório.
RUNNER_NAME=iparrot-vps

# Etiqueta que o workflow procura. Se mudar aqui, mude também a variável
# RUNNER_UBUNTU do repositório (veja o README.md desta pasta).
RUNNER_LABELS=iparrot-vps

# Teto de CPU e memória. O compilador Go chega a pedir perto de 4 GB para a
# árvore do IPFS/libp2p; menos de 4g aqui derruba o build por falta de
# memória. Deixe folga para o que já roda no servidor.
RUNNER_CPUS=2.0
RUNNER_MEM=6g
